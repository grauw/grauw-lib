<t:namespace name="http://www.grauw.nl/lib" object="gl.unit"
		xmlns="http://www.w3.org/1999/xhtml"
		xmlns:t="http://www.grauw.nl/templates">
	<!--
		Default value for extends is gl.core.Component.
		Must extend gl.core.Component. InstanceOf check is done.
		
		Maybe make t:Class for generic classes and t:Component for
		components (which allow t:template)?
	-->
	<t:class name="JSUnitLog" extends="gl.core.Component">
		<t:resource type="text/css">
			.gl-unit-log {
				position: absolute;
				width: 600px;
				top: 10px;
				right: 10px;
				font-family: Arial, sans-serif;
				font-size: smaller;
				opacity: 0.8;
				background-color: #ddf;
				border-radius: 5px;
				-moz-border-radius: 5px;
				-webkit-border-radius: 5px;
				padding: 5px;
			}
		</t:resource>
		<t:template>
			<div class="gl-unit-log"/>
		</t:template>
		<t:constructor>
			gl.core.Component.call(this, arguments[0]);
			//this.viewNode = this.getTemplate();
			//this.callSuper();
		</t:constructor>
		<t:method name="writeln" arguments="sString">
			var oDiv = document.createElement('div');
			oDiv.appendChild(document.createTextNode(sString));
			this.viewNode.appendChild(oDiv);
		</t:method>
		<t:method name="writelnError" arguments="sString">
			var oDiv = document.createElement('div');
			oDiv.style.color = '#f00';
			oDiv.appendChild(document.createTextNode(sString));
			this.viewNode.appendChild(oDiv);
		</t:method>
		<t:implementation>
			({
				
			})
		</t:implementation>
	</t:class>
</t:namespace>